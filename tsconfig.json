{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-dev/dev/types/**/*.ts",
    ".next-qa-nov5/types/**/*.ts",
    ".next-qa-nov5/dev/types/**/*.ts",
    ".next-qa-launch-nov5/types/**/*.ts",
    ".next-qa-launch-nov5/dev/types/**/*.ts",
    ".next-desktop/types/**/*.ts",
    ".next-desktop/dev/types/**/*.ts",
    ".next-desktop-build/types/**/*.ts",
    ".next-desktop-build/dev/types/**/*.ts",
    ".next-crm/types/**/*.ts",
    ".next-crm/dev/types/**/*.ts",
    ".next-crm-check/types/**/*.ts",
    ".next-crm-check/dev/types/**/*.ts",
    ".next-crm-lifecycle/types/**/*.ts",
    ".next-crm-lifecycle/dev/types/**/*.ts",
    ".next-interaction-nov9/types/**/*.ts",
    ".next-interaction-nov9/dev/types/**/*.ts",
    ".next-interaction-nov9-final/types/**/*.ts",
    ".next-interaction-nov9-final/dev/types/**/*.ts",
    ".next-interaction-nov9-verified/types/**/*.ts",
    ".next-interaction-nov9-verified/dev/types/**/*.ts",
    ".next-seated-look-nov9/types/**/*.ts",
    ".next-seated-look-nov9/dev/types/**/*.ts",
    ".next-maquette-dev/types/**/*.ts",
    ".next-maquette-dev/dev/types/**/*.ts",
    ".next-maquette-build/types/**/*.ts",
    ".next-maquette-build/dev/types/**/*.ts",
    ".next-living-maquette/types/**/*.ts",
    ".next-living-maquette/dev/types/**/*.ts",
    ".next-living-maquette-dev/types/**/*.ts",
    ".next-living-maquette-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

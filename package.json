{
  "name": "md-lounge-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test:interactions": "node --test qa/interaction.test.mjs",
    "test:avatar": "node --test qa/avatar.test.mjs",
    "test:controller": "node --test qa/controller-camera.test.mjs",
    "test:cinematic": "node --test qa/cinematic.test.mjs",
    "test:environment": "node --test qa/environment.test.mjs",
    "test:runtime": "node --test qa/runtime.test.mjs",
    "test:rendering": "node --test qa/rendering.test.mjs",
    "prebuild": "node scripts/verify-assets.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "test": "node --test qa/*.test.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "sharp": "0.35.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
